   "source": [
    "x = 1:.5:10\n",
    "\n",
    "y = sin.(x)\n",
    "\n",
    "itp = LinearInterpolation(x, y)\n",
    "\n",
    "new_x = 1:0.1:10\n",
    "\n",
    "new_y = itp.(new_x)\n",
    "\n",
    "plot(x, y, label=\"Original\")\n",
    "plot!(new_x, new_y, label=\"Interpolated\")\n",
    "\n",
    "\n",
    "\n",
    "\n"
   ]
